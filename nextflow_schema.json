{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/genomic-surveillance/rvi-viral-lens",
  "title": "Viral Lens pipeline parameters",
  "description": "identify the presence of Flu, SARS-CoV-2 and RSV and obtain, if possible, high quality consensus sequences for those virus.",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "db_library_fa_path": {
      "type": "string"
    },
    "outdir": {
      "type": "string",
      "default": "$launchDir/output/"
    },
    "do_scov2_subtyping": {
      "type": "boolean",
      "default": true
    },
    "scv2_keyword": {
      "type": "string",
      "default": "Severe acute respiratory syndrome coronavirus 2"
    },
    "kraken2_mem": {
      "type": "string",
      "default": "2.GB"
    },
    "kraken2_cpus": {
      "type": "integer",
      "default": 4
    },
    "k2r_polling_mode": {
      "type": "string",
      "default": "max"
    },
    "min_reads_for_taxid": {
      "type": "integer",
      "default": 100
    },
    "k2r_max_total_reads_per_fq": {
      "type": "integer",
      "default": 10000000
    },
    "read_aligner": {
      "type": "string",
      "default": "minimap2"
    },
    "read_aligner_params": {
      "type": "string",
      "default": "-ax sr -k11 -w 4"
    },
    "mpileup_max_depth": {
      "type": "integer",
      "default": 2000
    },
    "ivar_initial_min_depth": {
      "type": "integer",
      "default": 1
    },
    "ivar_initial_freq_threshold": {
      "type": "number",
      "default": 0.6
    },
    "ivar_polish_min_depth": {
      "type": "integer",
      "default": 10
    },
    "ivar_polish_freq_threshold": {
      "type": "number",
      "default": 0.75
    },
    "max_attempts": {
      "type": "integer",
      "default": 3
    },
    "default_error_strategy": {
      "type": "string",
      "default": "terminate"
    },
    "mem_k2r_b0_offset": {
      "type": "integer",
      "default": 2
    },
    "mem_k2r_b0": {
      "type": "number",
      "default": 1.23932729
    },
    "mem_k2r_b0_final": {
      "type": "number",
      "default": 3.23932729
    },
    "mem_k2r_b1": {
      "type": "number",
      "default": 3.57231124
    },
    "mem_k2r_f1": {
      "type": "number",
      "default": 1.5
    },
    "mem_k2r_a2": {
      "type": "integer",
      "default": 2
    },
    "tracedir": {
      "type": "string",
      "default": "./results/pipeline_info"
    },
    "max_memory": {
      "type": "string",
      "default": "2.9 TB"
    },
    "max_cpus": {
      "type": "integer",
      "default": 256
    },
    "max_time": {
      "type": "string",
      "default": "30d"
    },
    "max_retries": {
      "type": "integer",
      "default": 2
    },
    "retry_strategy": {
      "type": "string",
      "default": "ignore"
    },
    "queue_size": {
      "type": "string"
    },
    "submit_rate_limit": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "results_dir": {
      "type": "string"
    },
    "developer_publish": {
      "type": "boolean"
    },
    "do_preprocessing": {
      "type": "boolean"
    },
    "run_trimmomatic": {
      "type": "boolean",
      "default": true
    },
    "run_trf": {
      "type": "boolean",
      "default": true
    },
    "run_hrr": {
      "type": "boolean",
      "default": true
    },
    "publish_clean_reads": {
      "type": "boolean"
    },
    "debug_preproc_output": {
      "type": "boolean"
    },
    "nextclade_index_json": {
      "type": "string"
    },
    "do_sequence_index": {
      "type": "boolean",
      "default": false
    },
    "run_msweep": {
      "type": "boolean",
      "default": false
    },
    "msweep_themisto_index": {
      "type": "string",
      "default": "/data/pam/software/themisto2/viromeindex/1.0/rvdb_clustered_virome.thm2"
    },
    "msweep_ref_groups": {
      "type": "string",
      "default": "/data/pam/software/themisto2/viromeindex/1.0/rvdb_clustered_virome_species_labels.txt"
    },
    "msweep_subsample_limit": {
      "type": "integer",
      "default": 1000000
    },
    "cleanup_intermediate_files_msweep": {
      "type": "boolean",
      "default": false
    },
    "msweep_map_min_abundance": {
      "type": "number",
      "default": 0.001
    },
    "msweep_map_reference_fasta": {
      "type": "string",
      "default": "/data/pam/software/themisto2/viromeindex/1.0/data/C-RVDBv32.0.fasta"
    },
    "msweep_map_bowtie_threads": {
      "type": "integer",
      "default": 4
    },
    "msweep_map_reference_seed": {
      "type": "integer",
      "default": 12345
    },
    "run_metagraph_align": {
      "type": "boolean",
      "default": false
    },
    "run_metagraph_query": {
      "type": "boolean",
      "default": false
    },
    "metagraph_align_graph": {
      "type": "string"
    },
    "metagraph_align_annotation": {
      "type": "string"
    },
    "metagraph_align_annotation_seqs": {
      "type": "string"
    },
    "metagraph_align_names_dmp": {
      "type": "string",
      "default": "${projectDir}/assets/NO_NAMES_DMP"
    },
    "metagraph_align_min_kmers_fraction_label": {
      "type": "number",
      "default": 0.9
    },
    "metagraph_align_min_exact_match": {
      "type": "number",
      "default": 0.9
    },
    "metagraph_align_min_hits": {
      "type": "integer",
      "default": 100
    },
    "metagraph_align_subsample_limit": {
      "type": "integer",
      "default": 500000
    },
    "metagraph_align_run_map_qc": {
      "type": "boolean",
      "default": true
    },
    "metagraph_map_reference_fasta": {
      "type": "string"
    },
    "metagraph_map_bowtie_threads": {
      "type": "integer",
      "default": 4
    },
    "do_assembly": {
      "type": "boolean",
      "default": false
    },
    "subsample_iterations": {
      "type": "integer",
      "default": 1
    },
    "subsample_seed": {
      "type": "integer",
      "default": 12345
    },
    "metaspades_base_mem_gb": {
      "type": "integer",
      "default": 4
    },
    "metaspades_subsample_limit": {
      "type": "integer",
      "default": 500000
    },
    "genomad_db": {
      "type": "string"
    },
    "vrhyme_min_scaffold_length": {
      "type": "integer",
      "default": 2000
    },
    "vrhyme_bowtie_threads": {
      "type": "integer",
      "default": 4
    },
    "vrhyme_pool_min_identity": {
      "type": "number",
      "default": 0.95
    },
    "vrhyme_pool_min_aligned_length": {
      "type": "integer",
      "default": 50
    },
    "vrhyme_link_n": {
      "type": "integer",
      "default": 1000
    },
    "bowtie2_samtools_only_abundance_estimation": {
      "type": "boolean",
      "default": false
    },
    "checkv_db": {
      "type": "string"
    },
    "vcontact3_db_path": {
      "type": "string"
    },
    "vcontact3_db_version": {
      "type": "string",
      "default": "236"
    },
    "vcontact3_db_domain": {
      "type": "string",
      "default": "eukaryotes"
    },
    "vcontact3_postprocess_min_proteins": {
      "type": "integer",
      "default": 5
    },
    "vcontact3_postprocess_max_proteins": {
      "type": "integer",
      "default": 20
    },
    "do_abundance": {
      "type": "boolean",
      "default": false
    },
    "run_kraken2bracken": {
      "type": "boolean",
      "default": false
    },
    "run_abundance_estimation": {
      "type": "boolean",
      "default": false
    },
    "run_scrub": {
      "type": "boolean",
      "default": false
    },
    "kraken2bracken_kraken2_db": {
      "type": "string"
    },
    "kraken2bracken_kraken2_threads": {
      "type": "integer",
      "default": 4
    },
    "kraken2bracken_bracken_threads": {
      "type": "integer",
      "default": 10
    },
    "kraken2bracken_kmer_len": {
      "type": "integer",
      "default": 35
    },
    "kraken2bracken_read_len": {
      "type": "integer",
      "default": 150
    },
    "kraken2bracken_classification_level": {
      "type": "string",
      "default": "S"
    },
    "kraken2bracken_threshold": {
      "type": "integer",
      "default": 1
    },
    "kraken2bracken_get_classified_reads": {
      "type": "boolean",
      "default": false
    },
    "sourmash_subset_abundance_estimation": {
      "type": "boolean",
      "default": false
    },
    "instrain_quick_profile_abundance_estimation": {
      "type": "boolean",
      "default": false
    },
    "cleanup_intermediate_files_abundance_estimation": {
      "type": "boolean",
      "default": false
    },
    "instrain_full_output_abundance_estimation": {
      "type": "boolean",
      "default": false
    },
    "publish_host_reads_abundance_estimation": {
      "type": "boolean",
      "default": false
    },
    "genome_dir_abundance_estimation": {
      "type": "string"
    },
    "sourmash_db_abundance_estimation": {
      "type": "string"
    },
    "genome_file_abundance_estimation": {
      "type": "string",
      "default": ""
    },
    "precomputed_index_abundance_estimation": {
      "type": "string",
      "default": ""
    },
    "stb_file_abundance_estimation": {
      "type": "string"
    },
    "custom_taxon_names_abundance_estimation": {
      "type": "string",
      "default": ""
    },
    "bmtagger_db_abundance_estimation": {
      "type": "string"
    },
    "bmtagger_host_abundance_estimation": {
      "type": "string",
      "default": "T2T-CHM13v2.0"
    },
    "bowtie2_samtools_threads_abundance_estimation": {
      "type": "integer",
      "default": 4
    },
    "instrain_threads_abundance_estimation": {
      "type": "integer",
      "default": 4
    },
    "instrain_profile_options": {
      "type": "string",
      "default": "--database-mode"
    },
    "scrub_plate_map": {
      "type": "string"
    },
    "scrub_control_order": {
      "type": "string",
      "default": "control_blank"
    },
    "scrub_dist_threshold": {
      "type": "number",
      "default": 1.5
    },
    "scrub_sample_suffix": {
      "type": "string",
      "default": "_report_bracken_species"
    },
    "scrub_heatmap_top_n": {
      "type": "integer",
      "default": 40
    },
    "scrub_zero_species_in_controls": {
      "type": "string",
      "default": ""
    },
    "do_consensus_polishing": {
      "type": "boolean",
      "default": true
    }
  }
}
