nextflow_workflow {

    name "Test Workflow GENERATE_ASSEMBLY_REPORT"
    script "workflows/GENERATE_ASSEMBLY_REPORT.nf"
    workflow "GENERATE_ASSEMBLY_REPORT"

    test("Should run without failures - one sample, few scaffolds") {

        when {
            params {
                outdir = "$launchDir/results/"

                meta = [
                    id: "sample1",
                    sample_id: "sample1",
                    genomad_n_scaffolds: 3,
                    genomad_n_eligible: 2,
                    vrhyme_n_bins: 1,
                    vrhyme_n_binned_scaffolds: 2,
                    checkv_n_high_quality: 1,
                    checkv_n_medium_quality: 1,
                    vcontact3_n_genomes: 2,
                    vcontact3_n_clusters: 1
                ]
            }
            workflow {
                """
                input[0] = Channel.of([params.meta.id, params.meta])
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
