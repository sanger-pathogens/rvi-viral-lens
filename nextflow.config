// Copyright (C) 2023 Genome Surveillance Unit/Genome Research Ltd.

includeConfig "./conf/containers.config"
includeConfig "./rvi_toolbox/nextflow-commons.config"
// Widened input handling (rvi_integration_1, --do_mixed_input): pulls in mixed_input.config
// (studyid/runid/laneid/plexid/manifest_ena/manifest_of_lanes/manifest_of_reads) plus its
// own nested includes of irods.config and ena_downloader.config, unlike every other new
// lane this integration -- MIXED_INPUT/ENA_DOWNLOAD/DOWNLOAD_FROM_IRODS already live in
// viral-lens's own rvi_toolbox submodule (rvi/rvi_toolbox.git), not another fork, so
// there's no "shared submodule, can't includeConfig" problem here.
includeConfig "./rvi_toolbox/subworkflows/mixed_input.config"

manifest {
    name            = 'Viral Lens'
    author          = 'ARD'
    homePage        = 'https://github.com/genomic-surveillance/rvi-viral-lens'
    description     = 'identify the presence of Flu, SARS-CoV-2 and RSV and obtain, if possible, high quality consensus sequences for those virus.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.3'
    version         = 'v1.5.1'
}

plugins {
  id 'nf-schema@2.2.0'
}

params {

    // -- REQUIRED INPUT --//
    manifest = null

    // kraken database
    db_path = null
    db_library_fa_path = null
    // ---------------------- //

    // --- SET PIPELINE DEFAULT PARAMETERS --//

    // --- general pipeline
    // set where output files should be published
    outdir = "$launchDir/results/"

    // scov2 subtyping switchs
    do_scov2_subtyping = true

    // preprocessing of reads switch
    do_preprocessing = false
    run_trimmomatic = true
    run_trf = true
    run_hrr = true
    publish_clean_reads = false
    debug_preproc_output = false


    // --- SET WORKFLOW SPECIFIC DEFAULT PARAMETERS --- //

    // -- SUBTYPING
    // virus subtyping branching keywords
    scv2_keyword = "Severe acute respiratory syndrome coronavirus 2"

    // -- kraken
    kraken2_mem = "2.GB"
    kraken2_cpus = 4

    // -- Kraken2ref (k2r)
    k2r_polling_mode = "max"

    // kraken report minum number of reads filter
    min_reads_for_taxid = 100

    // set maximum number of reads to be accepted
    k2r_max_total_reads_per_fq = 10000000
    // any fastq file pair with more than that number of reads
    // will be splitted into N chunks, each containing that maximum
    // amount of reads to be processed by k2r. Those splitted files
    // are intemediate files and the final output will still be per
    // reported per sample.

    // ---------------------- //
    // -- CONSENSUS GENERATION
    // for original viral_lens (pre introduction of minimap2 and polishing), do:
    //   do_consensus_polishing = false
    //   read_aligner = "bwa"
    //   read_aligner_params = ""
    //   mpileup_max_depth = 0
    //   ivar_initial_min_depth = 10
    //   ivar_initial_freq_threshold = 0.75
    do_consensus_polishing = true
    read_aligner = "minimap2"
    read_aligner_params = "-ax sr -k11 -w 4"
    mpileup_max_depth = 2000
    ivar_initial_min_depth = 1
    ivar_initial_freq_threshold = 0.60
    ivar_polish_min_depth = 10
    ivar_polish_freq_threshold = 0.75
    // ---------------------- //

    // debug options
    developer_publish = false

    // nextclade
    nextclade_index_json = null

    // ---------------------- //
    // -- MAP READS TO SEQUENCE INDEXES (rvi_integration_1)
    // Three methods converging on one QC Mapping step (see docs/nf-metro/route_map.mmd's
    // seq_index_mapping section): Themisto2 pseudoalignment + mSWEEP abundance estimation
    // (workflows/VIRAL_MSWEEP.nf), sequence-to-graph alignment via Metagraph
    // (workflows/VIRAL_METAGRAPH_ALIGN.nf), and pseudoalignment via Metagraph -- the last
    // is not a real module anywhere upstream (see README's work-in-progress section) and
    // is not ported.
    do_sequence_index      = false  // master switch for the whole lane
    // One flag per method, so methods can be enabled independently. Both flags below
    // default false; enabling neither with do_sequence_index true runs nothing.
    run_msweep             = false
    run_metagraph_align    = false
    run_metagraph_query    = false  // pseudoalign via `metagraph query --query-mode labels` (see modules/metagraph_query.nf)

    // NB: the index moved under a versioned 1.0/ directory; rvi_toolbox's msweep.config
    // still points at the old flat paths, which no longer exist.
    msweep_themisto_index  = "/data/pam/software/themisto2/viromeindex/1.0/rvdb_clustered_virome.thm2"
    msweep_ref_groups      = "/data/pam/software/themisto2/viromeindex/1.0/rvdb_clustered_virome_species_labels.txt"
    msweep_subsample_limit = 1000000  // cap Themisto2/mSWEEP input depth at this many read pairs

    // Themisto pseudoalignment files are unpublished intermediates; remove them from the
    // work directory once MSWEEP has consumed them, to stop them accumulating.
    cleanup_intermediate_files_msweep = false

    // -- mSWEEP low-abundance hit validation (workflows/MSWEEP_MAP_QC.nf)
    msweep_map_min_abundance   = 0.001  // relative abundance above which a group is mapped/validated
    // Positionally aligned with msweep_ref_groups: record N == line N. Verified: both
    // hold 1321608 entries. rvi_toolbox's msweep_map_qc.config leaves this empty ("TBD").
    msweep_map_reference_fasta = "/data/pam/software/themisto2/viromeindex/1.0/data/C-RVDBv32.0.fasta"
    msweep_map_bowtie_threads  = 4
    msweep_map_reference_seed  = 12345  // reproducible tie-breaking among equal-longest sequences

    // -- Metagraph sequence-to-graph alignment (workflows/VIRAL_METAGRAPH_ALIGN.nf)
    // Ported from eu1/rvi_toolbox.git's feature_metagraph_align (merge commit f23d592) --
    // paths below are UNVERIFIED on this HPC (unlike msweep_* above, which were confirmed
    // against real files by the previous run). rvi_toolbox's metagraph_align.config points
    // at eu1's personal scratch (/lustre/.../personal/eu1/metagraph/bigviralindex-rvdbc/);
    // left null here rather than copying an unverified path -- validateParameters() will
    // fail loudly if run_metagraph_align is enabled without these set, same as
    // genomad_db/checkv_db/vcontact3_db_path below.
    metagraph_align_graph            = "/lustre/scratch126/pam/projects/rvidata/personal/eu1/metagraph/bigviralindex-rvdbc/viromeindex_clustered_graph.dbg"  // pre-built metagraph de Bruijn graph (.dbg)
    metagraph_align_annotation       = "/lustre/scratch126/pam/projects/rvidata/personal/eu1/metagraph/bigviralindex-rvdbc/column_annotation_coordinates.column_coord.annodbg"  // coordinate-annotation index (.annodbg) built against the same graph
    metagraph_align_annotation_seqs  = "/lustre/scratch126/pam/projects/rvidata/personal/eu1/metagraph/bigviralindex-rvdbc/column_annotation_coordinates.seqs"  // CoordToHeader mapping sidecar for the annotation; use assets/NO_ANNOTATION_SEQS if the index isn't coordinate-type
    metagraph_align_names_dmp        = "${projectDir}/assets/NO_NAMES_DMP"  // NCBI names.dmp for taxid-keyed labels; empty placeholder if the index's labels aren't taxid-keyed
    metagraph_align_min_kmers_fraction_label = 0.9  // metagraph align --min-kmers-fraction-label
    metagraph_align_min_exact_match          = 0.9  // metagraph align --align-min-exact-match
    metagraph_align_min_hits                 = 100  // minimum read-hit count for a species to be provisionally called present
    metagraph_align_subsample_limit          = 500000  // cap METAGRAPH/CALL_METAGRAPH_SPECIES input depth at this many reads per mate
    metagraph_align_run_map_qc               = true    // validate each called species by mapping reads against its most-hit reference record

    // -- Metagraph-align species-call validation (workflows/METAGRAPH_MAP_QC.nf)
    metagraph_map_reference_fasta = "/lustre/scratch126/pam/projects/rvidata/personal/eu1/rvdb-clustered/C-RVDBv32.0.renamed.fasta"  // reference multi-FASTA whose headers match metagraph's alignment accessions
    metagraph_map_bowtie_threads  = 4

    // ---------------------- //
    // -- DE NOVO ASSEMBLY + VIRAL BINNING (rvi_integration_1)
    do_assembly = false

    // -- SUBSAMPLE_ITER (rvi_toolbox/subworkflows/subsample.nf; not previously
    // used by viral-lens, so its own subsample.config was never included here)
    subsample_iterations = 1
    subsample_seed = 12345

    // -- metaSPAdes
    metaspades_base_mem_gb = 4
    metaspades_subsample_limit = 500000 // 500k reads per paired read file; 1M reads total

    // -- geNomad
    genomad_db = "/data/pam/software/genomad/genomad_db/genomad_db"

    // -- vRhyme
    vrhyme_min_scaffold_length     = 2000  // skip vRhyme unless geNomad found >=2 viral scaffolds longer than this (bp)
    vrhyme_bowtie_threads          = 4     // threads passed to bowtie2/samtools when mapping reads against the pooled viral scaffolds
    vrhyme_pool_min_identity       = 0.95  // coverm filter --min-read-percent-identity (drops cross-sample spurious alignments)
    vrhyme_pool_min_aligned_length = 50    // coverm filter --min-read-aligned-length
    vrhyme_link_n                  = 1000  // N-spacer length between scaffolds when linking bins into one record
    // -- BOWTIE2SAMTOOLS (modules/bowtie.nf) is shared with rvi_toolbox's
    // abundance_estimation subworkflow, whose config declares this param and
    // isn't included here yet (that lane is not ported). Declared with the
    // same upstream default so the shared module resolves it.
    bowtie2_samtools_only_abundance_estimation = false

    // -- CheckV
    checkv_db = "/data/pam/software/ViWrap/CheckV_db/"

    // -- vContact3
    vcontact3_db_path    = "/data/pam/software/vcontact3/"
    vcontact3_db_version = "236"
    vcontact3_db_domain  = "eukaryotes"
    vcontact3_postprocess_min_proteins = 5   // below this protein count, a novel-genus call is flagged uncertain_novel_
    vcontact3_postprocess_max_proteins = 20  // above this protein count, a novel-genus call is flagged uncertain_novel_

    // ---------------------- //
    // -- ABUNDANCE ESTIMATION (rvi_integration_1)
    do_abundance             = false  // master switch for the whole lane
    run_kraken2bracken       = false  // Kraken2 + Bracken species abundance (workflows/KRAKEN2BRACKEN.nf)
    run_abundance_estimation = false  // sourmash/inStrain genome-level profiling (rvi_toolbox's own ABUNDANCE_ESTIMATION)
    run_scrub                = false  // SCRuB cross-contamination decontamination, final step of the Kraken2+Bracken path only

    // results_dir: rvi_toolbox's kraken2/bracken/krakentools/instrain/bowtie modules
    // (kraken2bracken.nf, abundance_estimation.nf, and this lane's SCRuB port) all
    // publish under params.results_dir, a param viral-lens never declared because
    // nothing used to call them. Aliased to outdir rather than edited at the source,
    // same "don't touch the shared submodule" reasoning as bowtie2_samtools_only_
    // abundance_estimation below. Files viral-lens itself ported (workflows/
    // KRAKEN2BRACKEN.nf, SCRUB_DECONTAM.nf and their modules) use outdir directly and
    // ignore this.
    results_dir = params.outdir

    // -- Kraken2 + Bracken (rvi_toolbox/subworkflows/kraken2bracken.config defaults)
    // rvi_toolbox's kraken2bracken.config still names "/data/pam/software/kraken2/viral_kraken/",
    // which does not exist; the source pipeline's own nextflow.config overrides it to this.
    kraken2bracken_kraken2_db          = "/data/pam/software/kraken2/viral_20250402/k2_viral_20250402/"
    kraken2bracken_kraken2_threads     = 4
    kraken2bracken_bracken_threads     = 10
    kraken2bracken_kmer_len            = 35   // must match the bracken kmer-distribution database actually built
    kraken2bracken_read_len            = 150  // must match "database${kraken2bracken_read_len}mers.kmer_distrib" in the kraken2 db dir
    kraken2bracken_classification_level = 'S' // ['D','P','C','O','F','G','S'] -- taxonomic rank bracken re-estimates at
    kraken2bracken_threshold           = 1    // minimum reads for a classification at that rank
    kraken2bracken_get_classified_reads = false

    // -- ABUNDANCE_ESTIMATION (rvi_toolbox/subworkflows/abundance_estimation.config defaults)
    // Heavier, more speculative than the rest of this lane: sourmash/inStrain genome-level
    // profiling against a GTDB-style reference genome set, not viral-specific. All of the
    // path params below are UNVERIFIED on this HPC -- rvi_toolbox's own defaults pointed at
    // specific team162/pam paths that may or may not still exist; not copied as defaults
    // here for the same reason msweep's stale rvi_toolbox defaults weren't (see README).
    sourmash_subset_abundance_estimation        = false
    instrain_quick_profile_abundance_estimation = false
    // Default false, NOT the upstream true: rvi_toolbox's abundance_estimation.nf has a
    // real bug in its cleanup branch -- with this true and
    // bowtie2_samtools_only_abundance_estimation false (both upstream defaults), it hits
    // `CLEANUP_SORTED_BAM_FILES(INSTRAIN.out.sorted_bam)`, but `INSTRAIN` is never
    // included anywhere in that file (only INSTRAIN_PROFILE/INSTRAIN_QUICKPROFILE are) --
    // "No such variable: INSTRAIN" on every default-configured run. Can't fix at the
    // source (shared submodule); this default just avoids the branch entirely.
    cleanup_intermediate_files_abundance_estimation = false
    instrain_full_output_abundance_estimation   = false
    publish_host_reads_abundance_estimation     = false
    genome_dir_abundance_estimation   = null  // only used if sourmash_subset_abundance_estimation=true
    sourmash_db_abundance_estimation  = null  // only used if sourmash_subset_abundance_estimation=true
    // genome_file/precomputed_index: REQUIRED (non-optional) when
    // sourmash_subset_abundance_estimation=false (the default) -- rvi_toolbox itself has
    // no working default for either, using "" as its own "must be supplied" placeholder;
    // kept as "" here rather than null to match that exact upstream contract.
    genome_file_abundance_estimation       = "/data/pam/collections/refseq/release230/viral.1.1.genomic.fna"
    // a bowtie2 index PREFIX, not a file: the real index is <prefix>.{1..4,rev.1,rev.2}.bt2l.
    // Passed through Channel.of(), so it is never resolved as a path.
    precomputed_index_abundance_estimation = "/data/pam/software/bowtie2/refseq/release230/viral/viral.1.1.genomic.bt2"
    // rvi_toolbox's default is a GTDB (bacterial) .stb; the source pipeline overrides it
    // with this viral one, copied into files/ alongside the taxon-name dictionary.
    stb_file_abundance_estimation          = "${projectDir}/files/release230_viral.1.1.genomic_custom.stb"
    custom_taxon_names_abundance_estimation = "${projectDir}/files/handpicked_viral_taxa_short_names_dict.txt"
    bmtagger_db_abundance_estimation   = null  // UNVERIFIED
    bmtagger_host_abundance_estimation = "T2T-CHM13v2.0"
    bowtie2_samtools_threads_abundance_estimation = 4
    instrain_threads_abundance_estimation         = 4
    // inStrain 1.9.0 spells this with an underscore; the hyphenated form upstream
    // uses makes `inStrain profile` exit 2 with "unrecognized arguments".
    instrain_profile_options = "--database_mode"

    // -- SCRuB cross-contamination decontamination (workflows/SCRUB_DECONTAM.nf)
    // Ported from eu1/rvi_toolbox.git's feature_scrub_decontam (merge commit 7111c02) --
    // exists only on that fork, same "don't touch the submodule" situation as Metagraph.
    // Runs once per pipeline run against KRAKEN2BRACKEN's whole-run abundance_summary,
    // not per-sample -- decontamination inherently needs the whole batch together.
    scrub_plate_map      = null  // user-supplied metadata CSV (REQUIRED if run_scrub=true): is_control, sample_type, [sample_well]
    scrub_control_order  = "control_blank"  // comma-separated control-type names matching the plate map's sample_type column
    scrub_dist_threshold = 1.5    // SCRuB's own tool default
    scrub_sample_suffix  = "_report_bracken_species"  // matches KREPORT2MPA's own "${meta.id}_report_bracken_species.mpa.txt" naming
    scrub_heatmap_top_n  = 40
    scrub_zero_species_in_controls = ""

    // ---------------------- //
    // -- WIDER INPUT HANDLING (rvi_integration_1)
    // Off by default: existing --manifest usage (parse_mnf(), sample_id/reads_1/reads_2
    // columns) is completely untouched. When true, MIXED_INPUT (rvi_toolbox/subworkflows/
    // mixed_input.nf) takes over instead, merging up to three sources -- a local reads
    // manifest (its OWN id/R1/R2 column format, not parse_mnf()'s), ENA download
    // (--manifest_ena), and/or iRODS retrieval (--studyid/--runid/--laneid/--plexid or
    // --manifest_of_lanes) -- selected by which of those params are set. See
    // rvi_toolbox/subworkflows/mixed_input_README.md for the exact activation rules.
    // Reads still land in the same preprocessed_3tuple_ch shape everything downstream
    // expects either way.
    do_mixed_input = false
}

// Execution layer settings

process {
    // Set pipelines outputs
    // -- standard outputs
    withLabel: consensus_output {
        publishDir = [
            path: {"${params.outdir}/${meta.sample_id}/mapping/${meta.taxid}/"},
            overwrite: true,
            mode: "copy"
        ]
    }

    withLabel: run_output {
        publishDir = [
            path: {"${params.outdir}/"},
            overwrite: true,
            mode: "copy"
        ]
    }

    // mapping/assembly/abundance lanes' per-sample report json (rvi_integration_1):
    // no `.taxid` on this meta, so this can't share consensus_output's publishDir.
    withLabel: lane_output {
        publishDir = [
            path: {"${params.outdir}/${meta.sample_id}/reports/"},
            overwrite: true,
            mode: "copy"
        ]
    }

    // metaSPAdes catches its own known error/warning cases and re-exits with the
    // stored status (see modules/metaspades.nf) -- needs errexit (-e) off.
    withName:METASPADES {
        shell = ['/bin/bash', '-u']
    }

    // KRAKEN2/BRACKEN do the same known-error/warning catch-and-re-exit pattern (see
    // rvi_toolbox/modules/kraken2.nf, bracken.nf) -- same reason, from
    // kraken2bracken.config (not included here since that lane wasn't ported until now).
    withName:KRAKEN2 {
        shell = ['/bin/bash', '-u']
    }

    withName:BRACKEN {
        shell = ['/bin/bash', '-u']
    }

    // From abundance_estimation.config, same reasoning.
    withName:INSTRAIN_PROFILE {
        shell = ['/bin/bash', '-u']
    }

    withLabel: kraken {
        publishDir = [
            path: {"${params.outdir}/${meta.sample_id}/mapping/"},
            mode: 'copy',
            pattern: "*.kraken_report.txt"
        ]
    }

    // -- intermediate outputs
    withLabel: get_taxid_reference_files {
        publishDir = [
                enabled: params.developer_publish,
                path: {"${params.outdir}/developer_publish/reference_files/"},
                mode: 'copy'
        ]
    }
    withLabel: pangolin {
        publishDir = [
                enabled: params.developer_publish,
                path: {"${params.outdir}/developer_publish/${meta.sample_id}/${meta.taxid}/"},
                mode: 'copy',
                pattern: "*.csv"
        ]
    }

    withLabel: ivar {
        publishDir = [
                enabled: params.developer_publish,
                path: {"${params.outdir}/developer_publish/${meta.sample_id}/${meta.taxid}/"},
                mode: 'copy',
                pattern: "*.{txt,tsv,csv}"
        ]
    }

    withLabel: kraken2ref {
        publishDir = [
                enabled: params.developer_publish,
                path: {"${params.outdir}/developer_publish/${meta.sample_id}/reads_by_taxon/"},
                mode: 'copy',
                pattern: "*.{tsv,fq,json}"
        ]
    }


}

profiles {
    
    standard {

        docker {
            enabled = false
        }

        singularity {
            enabled = true
            autoMounts = true
            runOptions = '--writable-tmpfs'
        }

        process {
            // by default nextflow commons (1 cpu, 1GB, 1h)
            cache='lenient'
            executor='local'
        }

    }

    sanger_standard {
        params {
            max_retries = 3
            max_memory = 128.GB // 2.9.TB
            max_cpus = 32 // 256
            max_time = 6.h // 720.h
        }

        docker {
            enabled = false
        }

        singularity {
            enabled = true
            autoMounts = true
            runOptions = "--bind /lustre,/nfs,/software,/data/"
        }

        process {
            // by default nextflow commons (1 cpu, 1GB, 1h)
            cache='lenient'
            executor='local'

            // run k2r on lsf
            withName: run_k2r_sort_reads{
                executor = 'lsf'
            }

            withName: run_k2r_dump_fastqs_and_pre_report{
                executor = 'lsf'
            }

            // run kraken2 on lsf
            withName: run_kraken {
                executor = 'lsf'
                cpus = params.kraken2_cpus
                memory = {
                    def base_mem = params.kraken2_mem as nextflow.util.MemoryUnit
                    return base_mem * task.attempt
                }
            }

            withName: run_aligner {
                executor = 'lsf'
            }

            withName: run_ivar {
                executor = 'lsf'
                memory = {  (task.attempt == 1) ? 1.GB : 8.GB * (task.attempt - 1) }
            }

            withName: run_pangolin {
                executor = 'lsf'
                errorStrategy = 'retry'
                maxRetries = 2 
            }

            withName: run_nextclade {
                executor = 'lsf'
                memory = {  (task.attempt == 1) ? 1.GB : 4.GB * (task.attempt - 1) }
            }

            // preprocessing steps on lsf
            withName:TRIMMOMATIC {
                executor = "lsf"
            }

            withName:FASTQ2FASTA {
                executor = "lsf"
            }

            withName:TRF {
                executor = "lsf"
            }

            withName:RMREPEATFROMFASTQ {
                executor = "lsf"
            }

            withName:SEQTK_MERGEPE {
                executor = "lsf"
            }

            withName:SRA_HUMAN_SCRUBBER {
                executor = "lsf"
            }

            withName:SEQTK_SPLIT {
                executor = "lsf"
            }

            // -- map-reads-to-sequence-indexes lane (rvi_integration_1).
            // THEMISTO_PSEUDOALIGN and MSWEEP are cpu_16; INDEX_REFERENCE_FASTA reads a
            // ~4GB reference FASTA. None of these belong on the submit host.
            withName:THEMISTO_PSEUDOALIGN {
                executor = "lsf"
            }

            withName:MSWEEP {
                executor = "lsf"
            }

            withName:INDEX_REFERENCE_FASTA {
                executor = "lsf"
            }

            withName:SELECT_REFERENCE_RECORDS {
                executor = "lsf"
            }

            withName:EXTRACT_REFERENCE_SUBSET {
                executor = "lsf"
            }

            withName:SAMTOOLS_COVERAGE {
                executor = "lsf"
            }

            withName:AGGREGATE_SPECIES_COVERAGE {
                executor = "lsf"
            }

            withName:GENERATE_MSWEEP_MAP_SUMMARY {
                executor = "lsf"
            }

            // -- de novo assembly + viral binning lane (rvi_integration_1).
            // sanger_standard defaults to executor='local' and opts processes
            // into LSF individually, so the ported lane needs explicit entries
            // or it runs on the submit host. These are the heavy ones:
            // METASPADES/VCONTACT3 are cpu_16, GENOMAD is cpu_8/mem_32.
            withName:SUBSAMPLE_SEQTK {
                executor = "lsf"
            }

            withName:METASPADES {
                executor = "lsf"
            }

            withName:GENOMAD {
                executor = "lsf"
            }

            withName:POOL_VIRAL_SCAFFOLDS {
                executor = "lsf"
            }

            withName:BOWTIE_INDEX {
                executor = "lsf"
            }

            withName:BOWTIE2SAMTOOLS {
                executor = "lsf"
            }

            withName:COVERM_FILTER {
                executor = "lsf"
            }

            withName:COVERM_DEPTH {
                executor = "lsf"
            }

            withName:SUBSET_COVERAGE_FOR_SAMPLE {
                executor = "lsf"
            }

            withName:VRHYME_WITH_COVERAGE {
                executor = "lsf"
            }

            withName:LINK_BIN_SCAFFOLDS {
                executor = "lsf"
            }

            withName:CHECKV {
                executor = "lsf"
            }

            withName:VCONTACT3_PER_SAMPLE_PREP {
                executor = "lsf"
            }

            withName:VCONTACT3 {
                executor = "lsf"
            }

            withName:VCONTACT3_POSTPROCESS {
                executor = "lsf"
            }

            // -- Metagraph sequence-index methods (rvi_integration_1). Missed when those
            // lanes were first wired -- METAGRAPH_ALIGN/METAGRAPH_QUERY are cpu_16, and
            // without an explicit entry here sanger_standard runs them on the submit host
            // (same trap item 1's writeup already flagged for the assembly lane).
            withName:METAGRAPH_ALIGN {
                executor = "lsf"
            }

            withName:METAGRAPH_QUERY {
                executor = "lsf"
            }

            withName:CALL_METAGRAPH_SPECIES {
                executor = "lsf"
            }

            withName:EXTRACT_METAGRAPH_REFERENCE_SUBSET {
                executor = "lsf"
            }

            withName:AGGREGATE_METAGRAPH_COVERAGE {
                executor = "lsf"
            }

            withName:GENERATE_METAGRAPH_MAP_SUMMARY {
                executor = "lsf"
            }

            // -- abundance estimation lane (rvi_integration_1): Kraken2+Bracken, SCRuB,
            // ABUNDANCE_ESTIMATION.
            withName:KRAKEN2 {
                executor = "lsf"
            }

            withName:KRAKEN2_GET_CLASSIFIED {
                executor = "lsf"
            }

            withName:BRACKEN {
                executor = "lsf"
            }

            withName:KREPORT2MPA {
                executor = "lsf"
            }

            withName:GENERATE_ABUNDANCE_SUMMARY {
                executor = "lsf"
            }

            withName:REFORMAT_BRACKEN_FOR_SCRUB {
                executor = "lsf"
            }

            withName:SCRUB {
                executor = "lsf"
            }

            withName:SCRUB_HEATMAP {
                executor = "lsf"
            }

            withName:MERGE_FASTQS {
                executor = "lsf"
            }

            withName:SOURMASH_SKETCH {
                executor = "lsf"
            }

            withName:SOURMASH_GATHER {
                executor = "lsf"
            }

            withName:SUBSET_GTDB {
                executor = "lsf"
            }

            withName:GENERATE_STB {
                executor = "lsf"
            }

            withName:INSTRAIN_PROFILE {
                executor = "lsf"
            }

            withName:INSTRAIN_QUICKPROFILE {
                executor = "lsf"
            }

            withName:GENERATE_INSTRAIN_SUMMARY {
                executor = "lsf"
            }

            withName:GET_OVERALL_MAPPING_RATE {
                executor = "lsf"
            }

            //NOTE: processes that default to local execution:
            // get_taxid_reference_files
            // publish_consensus_files, publish_run_files
            // run_qc_script
            // write_properties_json

        }
        executor {
            jobName={ "RVI-viral-lens - $task.name - $task.tag" }
            perJobMemLimit=true

        }
    }
}

//---| memory escalation for k2r_sort_reads |

params {
    max_attempts = 3
    default_error_strategy = "terminate" // ["retry" or "terminate"]
    // attempt 1 -> y_pred = [(b0 + b0_offset) + b1*x]
    // attempt 2 -> y_pred * f1
    // attempt > 2 -> y_pred + a2
    mem_k2r_b0_offset = 2 // GB
    mem_k2r_b0= 1.23932729
    mem_k2r_b0_final = params.mem_k2r_b0 + params.mem_k2r_b0_offset
    mem_k2r_b1= 3.57231124
    mem_k2r_f1 = 1.5
    mem_k2r_a2 = 2
}

def bytesToSize(bytes, unit) {
    def values = [
        'B' : 1,
        'KB': 1024,
        'MB': 1024 * 1024,
        'GB': 1024 * 1024 * 1024
    ]

    def factor = values.get(unit)
    if (factor == null) {
        throw new Exception("Invalid unit: ${unit}")
    }

    return bytes / factor
}

def linear_regression_fit(x, b0, b1) {
    // y_pred = b0 + b1*x
    return b0 + b1*x
}

def retry_strategy(task, max_attempts, default_error_strategy){
    // this is borrow directly from PAM nextflow commons
    //
    def MISC_EXIT_CODES = [
        "SIGKILL": 137,
        "SIGTERM": 143,
        "SIGABRT": 134,
        "SIGSEGV": 139
    ].values()

    def SCALING_EXIT_CODES = [
        // see https://ssg-confluence.internal.sanger.ac.uk/pages/viewpage.action?pageId=101361150
        // LSF Runlimit exceeded or Out of memory Error; first signal allowing to quit cleanly
        "SIGUSR2": 140,

        // LSF Runlimit exceeded or Out of memory Error or bkill; second signal sent shortly
        // after the SIGUSR2 to make it quit if not done yet
        "SIGINT": 130,

        // LSF Runlimit exceeded or Out of memory Error; apparently what LSF issues after a while
        // once the above two signals have been sent and not acted upon. Apparently kills the job
        // instantly so that the exit status has not got time to be written into an .exitcode 
        // file and is not reported to the Nextflow master process - therefore the value 9 is
        // never seen here in practice; see below for actual value.
        // source of issue reported here https://github.com/nextflow-io/nextflow/issues/2847
        "SIGKILLNOW": 9,
        // supposedly the default value of $task.exitStatus; this is what it is set to when not 
        // set in the absence of an .exitcode file for the previous execution of the task, as
        // would happen in the case mentioned above
        "NOEXITCODE": 2147483647
    ].values()

    if (task.attempt > max_attempts) {
        return default_error_strategy
    }
    // ------------------------------------------------- //
    switch(task.exitStatus) {
        // if non scalable error, kill the pipeline without mercy
        case {it in MISC_EXIT_CODES}:
            // Ignore due to non-scalable error code
            return default_error_strategy

        // if scaling related error:
        case {it in SCALING_EXIT_CODES}:
            // Retry with more memory and longer time limit
            return 'retry'

        case {it == null}:
            /*
            If exitStatus is null as is the case on the first attempt return 'retry'
            */
            return 'retry'

        default:
            // Return the value of params.retry_strategy
            return default_error_strategy
    }

}

def k2r_escalate_memory_strategy(task, input_size_GB, b0=params.mem_k2r_b0, b1=params.mem_k2r_b1, f1=params.mem_k2r_f1, a2=params.mem_k2r_a2){
    /**
    * Escalate memory strategy for tasks.
    *
    * This function takes into account the input size in GB and applies a memory escalation strategy based on the task attempt number.
    *
    * The strategy involves linear regression to predict peak memory usage, with adjustments made based on the task attempt number.
    *
    * @param task    The task object
    * @param input_size_GB  The input size in GB
    * @param b0     Coefficient for linear regression
    * @param b1     Coefficient for linear regression
    * @param f1      Factor to multiply predicted peak memory usage (for second attempt)
    * @param a2      Additional memory allocation per attempt (in GB) after the first attempt
    *
    * @return  The escalated memory size in GB, taking into account the task attempt number and input size.
    */

    // predict peak mem
    peak_mem_pred = linear_regression_fit(input_size_GB,b0,b1)
    //println("${peak_mem_pred}, ${input_size_GB}, ${b0}, ${b1}")

    // if second try, add multiply predicted by factor 1 (f1)
    if (task.attempt == 2){
        return "${peak_mem_pred * f1} GB"
    }

    // if second attempt, add a2 gb to previous attempt
    if (task.attempt == 3){
        return "${(peak_mem_pred * f1) + a2} GB"
    }

    // keep adding a2 gb for each attempt
    if (task.attempt > 3) {
        return "${(peak_mem_pred * f1) + ((task.attempt) * a2)}"
    }

    // if first try, use linear regression
    return "${peak_mem_pred} GB"
}

process {
    errorStrategy = {retry_strategy(task, params.max_attempts, params.default_error_strategy) }
    max_retries = params.max_attempts

    withLabel:mem_k2r_escalate{
        //memory = "2 GB"

        memory = {k2r_escalate_memory_strategy(
                            task,
                            bytesToSize(meta.fqs_total_size, "GB"),
                            params.mem_k2r_b0_final,
                            params.mem_k2r_b1,
                            params.mem_k2r_f1,
                            params.mem_k2r_a2)}

    }

}
