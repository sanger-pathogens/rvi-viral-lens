nextflow_workflow {

    name "Test Workflow GENERATE_ABUNDANCE_REPORT"
    script "workflows/GENERATE_ABUNDANCE_REPORT.nf"
    workflow "GENERATE_ABUNDANCE_REPORT"

    test("Should run without failures - one sample") {

        when {
            params {
                outdir = "$launchDir/results/"

                meta = [
                    id: "sample1",
                    sample_id: "sample1",
                    bracken_n_species_called: 4,
                    scrub_ran: false
                ]
            }
            workflow {
                """
                input[0] = Channel.of([params.meta.id, params.meta])
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
